# 后端服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7001
# 前端跨域来源（TanStack Start 开发服务器）
CORS_ORIGINS=http://localhost:4001,http://127.0.0.1:4001

# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./jobmatch.db

# 国产大模型配置（OpenAI 兼容接口）
# 以 DeepSeek 为例；可替换为通义千问/智谱等兼容端点
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# LLM 单次请求超时（秒）。默认 300（5 分钟），匹配工作流各节点与整体、get_llm 客户端均沿用此值
LLM_TIMEOUT=300
