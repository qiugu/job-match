# 后端服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8005
# 前端跨域来源（开发与生产统一前端端口 3005；经 Nginx 同源代理时为对外访问地址）
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost,http://frontend:3005

# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./jobmatch.db

# 国产大模型配置（OpenAI 兼容接口）
# 以 DeepSeek 为例；可替换为通义千问/智谱等兼容端点
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# LLM 单次请求超时（秒）。默认 300（5 分钟），匹配工作流各节点与整体、get_llm 客户端均沿用此值
LLM_TIMEOUT=300

# ---------- 登录鉴权 ----------
# JWT 签名密钥。生产必填（建议 ≥32 字节随机串）；
# 留空时进程内随机生成，服务重启会导致所有登录态失效
AUTH_SECRET_KEY=
# 登录令牌有效期（分钟），默认 10080（7 天）
AUTH_TOKEN_EXPIRE_MINUTES=10080
# 是否开放注册；关闭后只能用初始账号/已有账号登录
AUTH_ALLOW_REGISTRATION=true
# 初始账号：服务启动时自动创建，并接管登录功能上线前的历史简历数据
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
# 注册码默认授予的匹配次数（JD 简历匹配与 JD 话术生成共享额度），默认 20
REGISTRATION_DEFAULT_MATCHES=20

# ---------- 服务端 PDF 导出（headless Chromium 矢量渲染） ----------
# 打印版 HTML 内 root-relative 字体 URL（/fonts/...）的解析源。
# 生产 compose 内默认 http://frontend:3005（backend 容器可直接访问 frontend 服务）；
# 本机开发（uvicorn 直跑 + vite dev）需覆盖为 http://localhost:3005
# PDF_EXPORT_FONT_ORIGIN=http://localhost:3005
# 接收 HTML 最大字节数（默认 2MB）
# PDF_EXPORT_MAX_HTML_BYTES=2097152
# 单次渲染内每个字体/图片资源服务端拉取上限字节（默认 24MB，需 > 最大字体文件 ~17MB）
# PDF_EXPORT_MAX_ASSET_BYTES=25165824
# 单次渲染超时秒数（默认 30）
# PDF_EXPORT_TIMEOUT_SECONDS=30
# 内联字体后 HTML 体积上限字节（默认 50MB；超此值直接拒绝渲染以防 Chromium 崩溃）
# PDF_EXPORT_MAX_INLINE_HTML_BYTES=52428800
# 最大并发渲染数（默认 2，低配机勿调高）
# PDF_EXPORT_MAX_CONCURRENCY=2
# 单用户每小时导出上限（默认 20）
# PDF_EXPORT_RATE_LIMIT_PER_HOUR=20
